# 数据目录（权限应为 0700）
WHISTLE_DATA_DIR=./data
# 部署地址
WHISTLE_BASE_URL=https://whistle.example.com
# HTTPS 部署时设为 true（启用 Secure Cookie + HSTS）
WHISTLE_SECURE=true
# 仅在可信反向代理后开启
WHISTLE_TRUST_PROXY=false
# "天"按哪个时区分桶（默认东八区）
WHISTLE_DAY_TZ_OFFSET_HOURS=8
# 员工登录会话时长（小时）
WHISTLE_STAFF_SESSION_HOURS=12
# 已结案案件保留天数（0 = 不自动清理）
WHISTLE_RETENTION_DAYS=0
# 单个附件上限（字节）
WHISTLE_MAX_ATTACHMENT_BYTES=8388608
# pepper 文件路径（丢失后所有凭据失效，务必单独备份）
# WHISTLE_PEPPER_FILE=/secure/offsite/pepper.key
